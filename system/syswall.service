[Unit]
Description=SysWall Firewall Daemon
After=network.target

[Service]
Type=notify
ExecStart=/usr/bin/syswall-daemon
Environment=SYSWALL_CONFIG=/etc/syswall/config.toml
User=root
Restart=on-failure
RestartSec=5s
WatchdogSec=30s

# --- Capacités minimales / Minimal capabilities ---
# CAP_NET_ADMIN : gestion nftables / nftables management
# CAP_NET_RAW   : conntrack, sockets bruts / raw sockets
# CAP_SYS_PTRACE : lecture /proc/<pid>/ d'autres processus / read other process /proc
# CAP_DAC_READ_SEARCH : lecture /proc/net sans restriction / unrestricted /proc/net access
# CAP_BPF       : chargement programmes eBPF / eBPF program loading
# CAP_PERFMON   : attachement tracepoints eBPF / eBPF tracepoint attachment
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_BPF CAP_PERFMON
AmbientCapabilities=CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_BPF CAP_PERFMON

# --- Durcissement du système de fichiers / Filesystem hardening ---
ProtectHome=read-only
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelLogs=true

# --- Restriction réseau / Network restrictions ---
# Seules les familles d'adresses nécessaires / Only needed address families
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# --- Restriction des appels système / System call restrictions ---
# Liste noire : bloquer les catégories dangereuses sans casser le runtime
# Blacklist: block dangerous categories without breaking the runtime
SystemCallFilter=~@clock @cpu-emulation @debug @module @mount @obsolete @raw-io @reboot @swap
SystemCallArchitectures=native

# --- Divers / Miscellaneous ---
# NoNewPrivileges=false requis pour eBPF JIT / required for eBPF JIT
NoNewPrivileges=false
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true

# --- Répertoires d'exécution / Runtime directories ---
RuntimeDirectory=syswall
RuntimeDirectoryMode=0755
ReadWritePaths=/var/lib/syswall /var/log/syswall /var/run/syswall

[Install]
WantedBy=multi-user.target
