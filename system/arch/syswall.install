post_install() {
    if ! getent group syswall > /dev/null 2>&1; then
        groupadd --system syswall
    fi
    # Utilisateur systeme dedie exige par User=syswall dans le unit.
    # Dedicated system user required by User=syswall in the unit.
    if ! getent passwd syswall > /dev/null 2>&1; then
        useradd --system --no-create-home --shell /usr/bin/nologin --gid syswall syswall
    fi
    mkdir -p /var/lib/syswall /var/log/syswall /var/run/syswall
    setcap 'cap_net_admin,cap_net_raw,cap_sys_ptrace,cap_dac_read_search,cap_bpf,cap_perfmon=ep' /usr/bin/syswall-daemon 2>/dev/null || true
    # Ajout de l'utilisateur courant au groupe syswall
    # Add current user to syswall group
    if [ -n "$SUDO_USER" ]; then
        usermod -aG syswall "$SUDO_USER"
        echo ">>> Utilisateur '$SUDO_USER' ajouté au groupe 'syswall'"
    fi

    # Activation et démarrage du service
    # Enable and start the service
    systemctl daemon-reload
    systemctl enable syswall
    systemctl start syswall

    echo ">>> SysWall installé et démarré !"
    echo ">>> Interface : syswall-ui"
    echo ">>> Logs : sudo journalctl -u syswall -f"
    echo ">>> NOTE : déconnectez-vous/reconnectez-vous pour le groupe 'syswall'"
}

post_upgrade() {
    post_install
    if systemctl is-active --quiet syswall; then
        systemctl restart syswall
    fi
}

pre_remove() {
    systemctl stop syswall 2>/dev/null || true
    systemctl disable syswall 2>/dev/null || true
}

post_remove() {
    systemctl daemon-reload
    echo ">>> Config preserved in /etc/syswall/. Remove manually if desired."
}
