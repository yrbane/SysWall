post_install() {
    /bin/sh /usr/share/syswall/postinst.sh

    # Ajout de l'utilisateur courant au groupe syswall
    # Add current user to syswall group
    if [ -n "$SUDO_USER" ]; then
        usermod -aG syswall "$SUDO_USER"
        echo ">>> Utilisateur '$SUDO_USER' ajoute au groupe 'syswall'"
    fi

    # Activation et demarrage du service
    # Enable and start the service
    systemctl enable syswall || true
    systemctl start syswall || true

    echo ">>> SysWall installe et demarre !"
    echo ">>> Interface : syswall-ui"
    echo ">>> Logs : sudo journalctl -u syswall -f"
    echo ">>> NOTE : deconnectez-vous/reconnectez-vous pour le groupe 'syswall'"
}

post_upgrade() {
    post_install
    if systemctl is-active --quiet syswall; then
        systemctl restart syswall || true
    fi
}

pre_remove() {
    /bin/sh /usr/share/syswall/prerm.sh
}

post_remove() {
    systemctl daemon-reload || true
    echo ">>> Config preserved in /etc/syswall/. Remove manually if desired."
}
